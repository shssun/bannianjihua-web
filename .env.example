# ---- Supabase（可选）----
# 二者都配置时才会启用后端；缺失时全站进入本地 fallback 降级路径，不会崩溃。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Cloudflare Turnstile（可选）----
# 配置后将启用留言板无感验证码；默认关闭。
VITE_TURNSTILE_SITE_KEY=
# 显式开关（默认 false）。即使配置了 site key，也需此项为 true 才渲染组件。
VITE_TURNSTILE_ENABLED=false

# ---- 构建（可选）----
# 部署到 GitHub Pages 子路径时设置，如 /bannianjihua_web/
# BASE_PATH=/
